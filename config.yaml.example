# Daily Photo Coach 配置

unsplash:
  # 去 https://unsplash.com/oauth/applications 创建应用后获取 Access Key
  access_key: "YOUR_UNSPLASH_ACCESS_KEY"

llm:
  url: "https://api.openai.com/v1/chat/completions"
  model: "gpt-4o"
  headers:
    Authorization: "Bearer YOUR_API_KEY"
  timeout: 300
  max_retries: 3

xhs:
  # 小红书公开分享页/公开笔记导入。默认使用 GPT-5.5 单独分析小红书图片。
  model: "gpt-5.5"
  style_label: "小红书｜人像自然"
  style_color: "#be185d"
  style_icon: "📕"
  max_notes_per_source: 6
  max_images_per_note: 10
  # 可选：仅用于你有权访问、但公开页偶发需要 Cookie 的场景；不要提交真实 Cookie。
  cookie: ""
  # 每天会从这些公开来源轮换一张小红书精选。公开搜索/主页可能需要登录；
  # 最稳定的是添加公开分享链接或笔记链接。
  sources:
    - name: "李贰腿"
      url: "http://xhslink.com/o/6vj01FlQoGl"
      style_label: "小红书｜人像自然"

daily:
  photos_per_style: 8
  styles:
    - query: "landscape nature mountain"
      label: "风光/自然"
      color: "#16a34a"
      icon: "🏔️"
    - query: "portrait photography"
      label: "人像/肖像"
      color: "#dc2626"
      icon: "👤"
    - query: "street photography documentary"
      label: "街头/人文"
      color: "#ea580c"
      icon: "🚶"

output:
  dir: "output"
