      "style_icon": "📕",
      "exif": {},
      "local_url_small": "assets/xhs/64b3f0c4000000003500a86b/xhs-64b3f0c4000000003500a86b-1-small.jpg",
      "local_url_regular": "assets/xhs/64b3f0c4000000003500a86b/xhs-64b3f0c4000000003500a86b-1-regular.jpg",
