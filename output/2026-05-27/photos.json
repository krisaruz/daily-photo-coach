      "local_url_regular": "assets/xhs/64ba91e5000000000800f849/xhs-64ba91e5000000000800f849-1-regular.jpg",
      "local_url_full": "assets/xhs/64ba91e5000000000800f849/xhs-64ba91e5000000000800f849-1-regular.jpg",
