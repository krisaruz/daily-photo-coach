      "local_url_small": "assets/xhs/643631310000000011011932/xhs-643631310000000011011932-1-small.jpg",
      "local_url_regular": "assets/xhs/643631310000000011011932/xhs-643631310000000011011932-1-regular.jpg",
      "local_url_full": "assets/xhs/643631310000000011011932/xhs-643631310000000011011932-1-regular.jpg",
